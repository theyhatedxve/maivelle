{
  "expo": {
    "name": "Maivelle",
    "slug": "maivelle-local-app",
    "scheme": "maivelle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/maivelle-app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#24105C",
        "foregroundImage": "./assets/branding/maivelle-app-icon.png"
      },
      "package": "com.devdb01.maivellelocalapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-system-ui",
      "./plugins/withAndroidBuildSettings.ts",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "maivelle-medicine",
          "color": "#6D42C7",
          "enableRemoteNotifications": false
        }
      ]
    ]
  }
}
